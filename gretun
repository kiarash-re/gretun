                2) ask_subnets v4 4 "" "Client IPv4 subnet(s)" "$v4" ;;
                3) ask_subnets v6 6 "" "Client IPv6 subnet(s) (or 'none')" "${v6:-none}" optional ;;
                4) ask a "Routing table number (PG_NODE_WG_ROUTE_TABLE)" "$tbl"
