# ======================================================================
# Extras: status, doctor, bench, tuning, alerts, install/uninstall
# ======================================================================
# ---------------------------------------------------------------- traffic
# Usage per interface (tunnels and the WireGuard interfaces of PasarGuard
# nodes), counted by heal every minute so it survives reboots and tunnel
# re-creation. One line per interface in traffic.db:
#   IFACE|IFINDEX|BOOT_ID|LAST_RX|LAST_TX|DAY|DAY_RX|DAY_TX|MONTH|MON_RX|MON_TX|ALL_RX|ALL_TX
# Finished days go to traffic-days as DATE|IFACE|RX|TX.
TRAFFIC_DB="$STATE/traffic.db"
TRAFFIC_DAYS="$STATE/traffic-days"
traffic_ifaces() {
    local n f seen=" "
    for n in $(tun_list); do seen+="$n "; printf '%s\n' "$n"; done
    for f in "$PG_DIR"/*.conf; do
        n=$(conf_val "$f" WG_IF wg0)
        [[ "$seen" == *" $n "* ]] || { seen+="$n "; printf '%s\n' "$n"; }
    done
}
traffic_kind() {  # a short description of an interface
    if [[ -f "$TUN_DIR/$1.conf" ]]; then
        case "$(conf_val "$TUN_DIR/$1.conf" ROLE)" in iran) printf 'tunnel to foreign' ;; foreign) printf 'tunnel to Iran' ;; *) printf tunnel ;; esac
    else
        printf 'WireGuard clients'
    fi
}
# traffic_update 0|1: prints the up-to-date rows; with 1 they are also saved.
traffic_update() {
    local boot day mon i line out="" days=""
    local -A row=()
    boot=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo none)
    day=$(date +%F) mon=$(date +%Y-%m)
    if [[ -f "$TRAFFIC_DB" ]]; then
        while IFS= read -r line; do
            [[ -z "$line" || "$line" == \#* ]] && continue
            row[${line%%|*}]="$line"
        done <"$TRAFFIC_DB"
    fi
    for i in $(traffic_ifaces); do
        local f_ifx f_boot lrx ltx d drx dtx m mrx mtx arx atx ifx rx tx inc_rx=0 inc_tx=0
        IFS='|' read -r _ f_ifx f_boot lrx ltx d drx dtx m mrx mtx arx atx \
            <<<"${row[$i]:-$i|||0|0|$day|0|0|$mon|0|0|0|0}"
        if ifx=$(iface_index "$i"); then
            read -r rx tx < <(iface_bytes "$i")
            if [[ -z "${row[$i]:-}" ]]; then
                # First time this interface is seen: only remember where it stands now
                # (its lifetime counters are not "today").
                inc_rx=0 inc_tx=0
            elif [[ "$f_ifx" == "$ifx" && "$f_boot" == "$boot" ]] && (( rx >= lrx && tx >= ltx )); then
                inc_rx=$((rx - lrx)) inc_tx=$((tx - ltx))
            else
                # New interface, recreated tunnel or reboot: its counters started at 0.
                inc_rx=$rx inc_tx=$tx
            fi
            lrx=$rx ltx=$tx f_ifx=$ifx f_boot=$boot
        fi
        if [[ "$d" != "$day" ]]; then
            if (( drx + dtx > 0 )); then days+="$d|$i|$drx|$dtx"$'\n'; fi
            d=$day drx=0 dtx=0
        fi
        if [[ "$m" != "$mon" ]]; then m=$mon mrx=0 mtx=0; fi
        drx=$((drx + inc_rx)) dtx=$((dtx + inc_tx))
        mrx=$((mrx + inc_rx)) mtx=$((mtx + inc_tx))
        arx=$((arx + inc_rx)) atx=$((atx + inc_tx))
        out+="$i|$f_ifx|$f_boot|$lrx|$ltx|$d|$drx|$dtx|$m|$mrx|$mtx|$arx|$atx"$'\n'
    done
    printf '%s' "$out"
    if (( $1 && ! DRY )) && [[ -n "$out" ]]; then
        mkdir -p "$STATE"
        printf '%s\n%s' "$MARK" "$out" >"$TRAFFIC_DB.tmp" && mv -f "$TRAFFIC_DB.tmp" "$TRAFFIC_DB"
        if [[ -n "$days" ]]; then
            printf '%s' "$days" >>"$TRAFFIC_DAYS"
            # About a year of history is plenty.
            if (( $(wc -l <"$TRAFFIC_DAYS") > 4000 )); then
                tail -n 3000 "$TRAFFIC_DAYS" >"$TRAFFIC_DAYS.tmp" && mv -f "$TRAFFIC_DAYS.tmp" "$TRAFFIC_DAYS"
            fi
        fi
    fi
}
# traffic_sum ROWS FIELD_RX FIELD_TX [tunnels]: total of two fields over the rows
traffic_sum() {
    local tf
    tf=" $(tun_list | tr '\n' ' ') "
    awk -F'|' -v a="$2" -v b="$3" -v only="${4:-}" -v tf="$tf" '
        only == "" || index(tf, " " $1 " ") { s += $a + $b } END { printf "%.0f", s }' <<<"$1"
}
cmd_traffic() {
    local rows i line d drx dtx m mrx mtx arx atx k ntun=0 lin=in lout=out
    local tdi=0 tdo=0 tmi=0 tmo=0 tai=0 tao=0
    local -a days_=()
    rows=$(traffic_update 1)
    [[ -n "$rows" ]] || { info "No tunnel or WireGuard interface to count yet."; return 0; }
    if (( UTF )); then lin="$(arrow_in) in" lout="$(arrow_out) out"; fi
    section "Traffic"
    printf '%s%s = received by this server, %s = sent by it.%s\n' "$DIM" "$lin" "$lout" "$NC"
    while IFS='|' read -r i _ _ _ _ d drx dtx m mrx mtx arx atx; do
        [[ -n "$i" ]] || continue
        if [[ -f "$TUN_DIR/$i.conf" ]]; then
            ntun=$((ntun + 1))
            tdi=$((tdi + drx)) tdo=$((tdo + dtx)) tmi=$((tmi + mrx)) tmo=$((tmo + mtx)) tai=$((tai + arx)) tao=$((tao + atx))
        fi
        printf '\n%s%s%s  %s%s%s\n' "$BOLD" "$i" "$NC" "$DIM" "$(traffic_kind "$i")" "$NC"
        # Sizes are right-aligned, so the units line up.
        printf '%s  %-9s %s %s %10s%s\n' "$DIM" "" "$(rpad "$lin" 10)" "$(rpad "$lout" 10)" "total" "$NC"
        printf '  %-9s %10s %10s %10s\n' "today" "$(fmt_bytes "$drx")" "$(fmt_bytes "$dtx")" "$(fmt_bytes $((drx + dtx)))"
        printf '  %-9s %10s %10s %10s\n' "$m" "$(fmt_bytes "$mrx")" "$(fmt_bytes "$mtx")" "$(fmt_bytes $((mrx + mtx)))"
        printf '  %-9s %10s %10s %10s\n' "all time" "$(fmt_bytes "$arx")" "$(fmt_bytes "$atx")" "$(fmt_bytes $((arx + atx)))"
        # The last 7 days (today included) as bars.
        days_=()
        if [[ -f "$TRAFFIC_DAYS" ]]; then
            while IFS='|' read -r k line; do days_+=("$k|$line"); done \
                < <(awk -F'|' -v i="$i" '$2 == i { s[$1] += $3 + $4 } END { for (d in s) print d "|" s[d] }' "$TRAFFIC_DAYS" | sort | tail -n 6)
        fi
        days_+=("$d|$((drx + dtx))")
        if (( ${#days_[@]} > 1 )); then
            local max=0 v
            for line in "${days_[@]}"; do v="${line#*|}"; (( v > max )) && max=$v; done
            printf '  %slast %s days with traffic%s\n' "$DIM" "${#days_[@]}" "$NC"
            for line in "${days_[@]}"; do
                v="${line#*|}" k="${line%%|*}"
                printf '    %s  %s %9s\n' "${k:5}" "$(bar 20 "$v" "$max")" "$(fmt_bytes "$v")"
            done
        fi
    done <<<"$rows"
    if (( ntun > 1 )); then
        printf '\n%sAll tunnels%s\n' "$BOLD" "$NC"
        printf '  %-9s %10s %10s %10s\n' "today" "$(fmt_bytes "$tdi")" "$(fmt_bytes "$tdo")" "$(fmt_bytes $((tdi + tdo)))"
        printf '  %-9s %10s %10s %10s\n' "$(date +%Y-%m)" "$(fmt_bytes "$tmi")" "$(fmt_bytes "$tmo")" "$(fmt_bytes $((tmi + tmo)))"
        printf '  %-9s %10s %10s %10s\n' "all time" "$(fmt_bytes "$tai")" "$(fmt_bytes "$tao")" "$(fmt_bytes $((tai + tao)))"
    fi
    if (( IN_MENU )); then printf '\n%sCounted every minute. Live speed: 4) Traffic > 2)%s\n' "$DIM" "$NC"
    else printf '\n%sCounted every minute. Live speed: gretun traffic live%s\n' "$DIM" "$NC"; fi
}
cmd_traffic_live() {
    local iv="${O_INTERVAL:-1}" cols w sw n i now prev_t dt rin rout peak line fr l el="" tin tout ntun
    local -a ifs=()
    local -A prx=() ptx=() hist=() pk=() sesrx=() sestx=()
    [[ "$iv" =~ ^[0-9]+$ ]] && (( iv >= 1 )) || iv=1
    mapfile -t ifs < <(traffic_ifaces)
    for i in "${ifs[@]}"; do iface_exists "$i" || continue; n=1; done
    (( ${n:-0} )) || die "No tunnel or WireGuard interface is up."
    exec 9>&-
    if [[ -t 1 ]]; then
        # Each frame overwrites the last one in place (no clear, no flicker).
        el=$'\033[K'
        printf '\033[?25l\033[H\033[2J'
        trap 'printf "\033[?25h"' EXIT
    fi
    trap 'printf "\n"; exit 0' INT TERM
    for i in "${ifs[@]}"; do
        hist[$i]="" pk[$i]=0 sesrx[$i]=0 sestx[$i]=0 prx[$i]="" ptx[$i]=""
        if iface_exists "$i"; then read -r "prx[$i]" "ptx[$i]" < <(iface_bytes "$i"); fi
    done
    prev_t=$(date +%s.%N)
    while :; do
        sleep "$iv"
        now=$(date +%s.%N)
        dt=$(awk -v a="$now" -v b="$prev_t" 'BEGIN { print (a - b > 0 ? a - b : 1) }')
        prev_t="$now"
        cols=$(term_cols)
        # "  ↓   " + bar + " " + rate (12): the bar takes the rest, 8-30 wide.
        w=$((cols - 21)); (( w > 30 )) && w=30; (( w < 8 )) && w=8
        # The sparkline and "  peak 999.99 Mbit/s" share one line.
        sw=$((cols - 25)); (( sw > 40 )) && sw=40; (( sw < 8 )) && sw=8
        fr="" tin=0 tout=0 ntun=0
        printf -v l '%sgretun live traffic%s  %s   %severy %ss, Ctrl+C stops%s' "$BOLD" "$NC" "$(date +%H:%M:%S)" "$DIM" "$iv" "$NC"
        fr+="$l"$'\n'"$(hrule)"$'\n'
        for i in "${ifs[@]}"; do
            local rx tx
            if ! iface_exists "$i"; then
                printf -v l '%s%s%s  %s %s' "$BOLD" "$i" "$NC" "$(sdot bad)" "$(paint bad down)"
                fr+="$l"$'\n\n'
                prx[$i]="" ptx[$i]=""
                continue
            fi
            read -r rx tx < <(iface_bytes "$i")
            # Just came up, or its counters restarted: start from here (no false spike).
            if [[ -z "${prx[$i]}" ]] || (( rx < prx[$i] )); then prx[$i]=$rx; fi
            if [[ -z "${ptx[$i]}" ]] || (( tx < ptx[$i] )); then ptx[$i]=$tx; fi
            rin=$(( rx - prx[$i] )) rout=$(( tx - ptx[$i] ))
            sesrx[$i]=$(( sesrx[$i] + rin )) sestx[$i]=$(( sestx[$i] + rout ))
            prx[$i]=$rx ptx[$i]=$tx
            # Rates in bit/s; the bars use the highest rate seen (at least 1 Mbit/s).
            rin=$(awk -v b="$rin" -v t="$dt" 'BEGIN { printf "%.0f", b * 8 / t }')
            rout=$(awk -v b="$rout" -v t="$dt" 'BEGIN { printf "%.0f", b * 8 / t }')
            if [[ -f "$TUN_DIR/$i.conf" ]]; then tin=$((tin + rin)) tout=$((tout + rout)) ntun=$((ntun + 1)); fi
            (( rin > pk[$i] )) && pk[$i]=$rin
            (( rout > pk[$i] )) && pk[$i]=$rout
            peak=${pk[$i]}; (( peak < 1000000 )) && peak=1000000
            hist[$i]="${hist[$i]} $((rin + rout))"
            read -r -a line <<<"${hist[$i]}"
            (( ${#line[@]} > sw )) && line=("${line[@]: -$sw}") && hist[$i]=" ${line[*]}"
            printf -v l '%s%s%s  %s%s%s' "$BOLD" "$i" "$NC" "$DIM" "$(traffic_kind "$i")" "$NC"
            fr+="$l"$'\n'
            printf -v l '  %-3s %s %12s' "$(arrow_in)" "$(bar "$w" "$rin" "$peak")" "$(fmt_rate "$((rin / 8))" 1)"
            fr+="$l"$'\n'
            printf -v l '  %-3s %s %12s' "$(arrow_out)" "$(bar "$w" "$rout" "$peak")" "$(fmt_rate "$((rout / 8))" 1)"
            fr+="$l"$'\n'
            local mx=0 v
            for v in "${line[@]}"; do (( v > mx )) && mx=$v; done
            printf -v l '  %s%s%s  %speak %s%s' "$GREEN" "$(spark "$mx" "${line[@]}")" "$NC" "$DIM" "$(fmt_rate "$((pk[$i] / 8))" 1)" "$NC"
            fr+="$l"$'\n'
            printf -v l '  %sthis view: %s %s  %s %s%s' "$DIM" "$(arrow_in)" "$(fmt_bytes "${sesrx[$i]}")" "$(arrow_out)" "$(fmt_bytes "${sestx[$i]}")" "$NC"
            fr+="$l"$'\n\n'
        done
        if (( ntun > 1 )); then
            printf -v l '%sAll tunnels%s  %s %s   %s %s' "$BOLD" "$NC" "$(arrow_in)" "$(fmt_rate "$((tin / 8))" 1)" \
                "$(arrow_out)" "$(fmt_rate "$((tout / 8))" 1)"
            fr+="$l"$'\n'
        fi
        # One write per frame; every line clears what is left of the old one.
        if [[ -t 1 ]]; then printf '\033[H%s\033[J' "${fr//$'\n'/$el$'\n'}"; else printf '%s' "$fr"; fi
    done
}
cmd_status() {
    local f any=0 tcp udp
    menu_state
    section "Server"
    kv Name "$(hostname 2>/dev/null || echo '?')" 9
    kv Role "$(server_role)" 9
    f=$(detect_local 4); if [[ -n "$f" ]]; then kv IPv4 "$f" 9; fi
    f=$(detect_local 6); if [[ -n "$f" ]]; then kv IPv6 "$f" 9; fi
    section "Tunnels"
    tunnel_status
    fwd_load
    if (( ${#F_LISTEN[@]} )); then
        section "Port forwarding"
        tcp=$(fwd_count tcp) udp=$(fwd_count udp)
        if (( tcp )); then
            if svc_active haproxy; then kv "TCP" "$(sdot ok) haproxy running" 9
            else kv "TCP" "$(sdot bad) $(paint bad "haproxy stopped")" 9; fi
        fi
        if (( udp )); then
            if svc_active "$UDP_UNIT"; then kv "UDP" "$(sdot ok) $UDP_UNIT running" 9
            else kv "UDP" "$(sdot bad) $(paint bad "$UDP_UNIT stopped")" 9; fi
        fi
        printf '\n'
        cmd_fwd_list
    fi
    for f in "$PG_DIR"/*.conf; do
        (( any )) || section "PasarGuard node (Iran side)"
        any=1
        printf '  %s%s%s\n' "$BOLD" "$(conf_val "$f" NODE)" "$NC"
        kv "  via" "$(conf_val "$f" TUNNEL), WireGuard $(conf_val "$f" WG_IF wg0)" 10
        kv "  table" "$(conf_val "$f" TABLE)" 10
        kv "  clients" "$(conf_val "$f" V4_SUBNETS) $(conf_val "$f" V6_SUBNETS)" 10
    done
    any=0
    for f in "$EXIT_DIR"/*.conf; do
        (( any )) || section "Exit (foreign side)"
        any=1
        printf '  %svia %s%s\n' "$BOLD" "$(conf_val "$f" TUNNEL)" "$NC"
        kv "  clients" "$(conf_val "$f" V4_SUBNETS) $(conf_val "$f" V6_SUBNETS)" 10
        kv "  wan" "$(conf_val "$f" WAN4 auto) / $(conf_val "$f" WAN6 auto)" 10
    done
    if rb_pending; then
        printf '\n'
        warn "Waiting for OK: $(cat "$RB_PENDING/label") ($(rb_left) left)."
        if (( IN_MENU )); then hint "Keep it: 7) Tools > 5    Undo it now: 7) Tools > 6"
        else hint "Keep it: gretun confirm    Undo it now: gretun rollback"; fi
    fi
}

# Doctor lines: [ok] fine, [!!] a problem (counted, listed again at the end),
# [--] information. Long lines wrap under the text, not under the tag.
DR_ISSUES=0
DR_LIST=()
dr_line() {  # dr_line COLOUR TAG TEXT
    local w
    w=$(term_cols)
    (( w > 100 )) && w=100
    printf '%s\n' "$3" | fold -s -w "$((w - 8))" | sed -e 's/ *$//' \
        -e "1s/^/  $1$2$NC /" -e '2,$s/^/       /'
}
dr_ok() { dr_line "$GREEN" "[ok]" "$*"; }
dr_bad() { dr_line "$YELLOW" "[!!]" "$*"; DR_ISSUES=$((DR_ISSUES + 1)); DR_LIST+=("$*"); }
dr_info() { dr_line "$DIM" "[--]" "$*"; }
cmd_doctor() {
    local n t w v out wgs
    DR_ISSUES=0 DR_LIST=()
    section "System"
    dr_info "gretun $VERSION, $(os_field PRETTY_NAME), kernel $(uname -r)"
    if legacy_present; then dr_bad "haproxy-forwarder is still installed"; hint "Import it: gretun tunnel import legacy"; fi
    if (( ! TEST_MODE )) && svc_enabled nftables.service; then
        dr_bad "nftables.service is enabled: restarting it runs /etc/nftables.conf, which usually flushes ALL rules"
        hint "gretun never needs it. If that happens, the heal timer"
        hint "restores gretun's rules within a minute."
    fi
    if rb_pending; then dr_bad "A change waits for confirmation: $(cat "$RB_PENDING/label")"; hint "gretun confirm   or   gretun rollback"; fi

    section "Tunnels"
    if [[ -z "$(tun_list)" ]]; then dr_info "no tunnels"; fi
    for n in $(tun_list); do
        tun_load "$n" || continue
        if ! iface_exists "$n"; then
            dr_bad "$n: interface missing"
            hint "gretun heal   (or: systemctl restart gretun@$n)"
            hint "For ip6gre, 'modprobe ip6_gre' must work."
            continue
        fi
        link_info "$n"
        if (( LI_UP )); then dr_ok "$n: up ($LI_KIND ${C[LOCAL]} -> ${C[REMOTE]})"; else dr_bad "$n: down"; fi
        [[ "$LI_MTU" == "${C[MTU]}" ]] && dr_ok "$n: mtu $LI_MTU" || dr_bad "$n: mtu $LI_MTU, configured ${C[MTU]}"
        out=$(offload_state "$n")
        [[ "$out" == *on* ]] && dr_bad "$n: offload $out (should be off)" || dr_ok "$n: offload $out"
        local_has_addr "${C[LOCAL]}" || { dr_bad "$n: local address ${C[LOCAL]} is not on this server any more"
            hint "If the server got a new IP: remove the tunnel and pair again."; }
        if ping_peer "${C[IN4_PEER]}" 4; then
            dr_ok "$n: ping ${C[IN4_PEER]} ${PING_RTT} ms, ${PING_LOSS}% loss"
            if ! ping -n -q -c 1 -W 2 -M "do" -s $((C[MTU] - 28)) "${C[IN4_PEER]}" >/dev/null 2>&1; then
                dr_bad "$n: full-size packets (MTU ${C[MTU]}) do not pass"
                hint "Lower the MTU on both sides, e.g.:"
                hint "gretun tunnel edit $n --mtu $((C[MTU] - 40))"
            else
                dr_ok "$n: full-size packets pass (MTU ${C[MTU]})"
            fi
        else
            dr_bad "$n: no reply from ${C[IN4_PEER]}"
            hint "Is the tunnel set up on the other server (gretun tunnel list there)?"
            hint "Does the provider block GRE (protocol 47)?"
            hint "Is the other server's address still ${C[REMOTE]}?"
        fi
        if [[ -n "${C[IN6_PEER]:-}" ]]; then
            if ping_peer "${C[IN6_PEER]}" 3; then dr_ok "$n: IPv6 ping ${C[IN6_PEER]} ${PING_RTT} ms"
            else dr_bad "$n: no IPv6 reply from ${C[IN6_PEER]}"; hint "Update gretun on the other server and run 'gretun heal' there."; fi
        fi
        v=$(sysctl_get "net/ipv4/conf/$n/rp_filter")
        [[ "$v" != 1 ]] && dr_ok "$n: rp_filter $v" || dr_bad "$n: rp_filter 1 (strict) can drop returning client traffic"
    done

    section "Firewall"
    if nft list table inet "$NFT_T" >/dev/null 2>&1; then dr_ok "nft table inet $NFT_T (GRE accept, MSS clamp)"
    elif [[ -n "$(tun_list)" ]]; then dr_bad "nft table inet $NFT_T missing"; hint "gretun heal"; fi
    for t in iptables ip6tables; do
        have "$t" || continue
        if "$t" -w 5 -C INPUT -m comment --comment gretun -j GRETUN-IN >/dev/null 2>&1; then
            dr_ok "$t: GRETUN-IN ($("$t" -w 5 -S GRETUN-IN 2>/dev/null | grep -c '^-A') rules), GRETUN-FWD ($("$t" -w 5 -S GRETUN-FWD 2>/dev/null | grep -c '^-A') rules)"
        elif [[ -n "$(tun_list)" ]]; then dr_bad "$t: jump to GRETUN-IN missing"; hint "gretun heal"; fi
    done
    if ufw_active; then dr_info "ufw is active; gretun's chains are evaluated before ufw's."; fi
    out=$(nft list ruleset 2>/dev/null | awk '/^table/ {tb = $2 " " $3} /policy drop/ && tb !~ /gretun/ && tb !~ /^(ip|ip6) (filter|nat|mangle|raw)$/ {print tb}' | sort -u)
    if [[ -n "$out" ]]; then
        dr_bad "native nftables chains with 'policy drop' outside gretun: $(paste -sd, <<<"$out")"
        hint "An accept in gretun's table cannot override a drop elsewhere."
        hint "Add these to that table's input chain yourself:"
        hint "meta l4proto 47 accept   and   iifname \"gre*\" accept"
    fi
    if nft list table ip "${NFT_T}_nat" >/dev/null 2>&1 || nft list table ip6 "${NFT_T}_nat" >/dev/null 2>&1; then
        dr_ok "NAT: $(nft list table ip "${NFT_T}_nat" 2>/dev/null | grep -c masquerade) IPv4 + $(nft list table ip6 "${NFT_T}_nat" 2>/dev/null | grep -c masquerade) IPv6 masquerade rules"
    fi

    section "Routing"
    out=$(ip -4 rule show | grep -vE '^(0|32766|32767):' || true)
    [[ -n "$out" ]] && printf '%s\n' "$out" | sed -e "s/^/       ${DIM}ip rule     /" -e "s/\$/${NC}/"
    out=$(ip -6 rule show | grep -vE '^(0|32766|32767):' || true)
    [[ -n "$out" ]] && printf '%s\n' "$out" | sed -e "s/^/       ${DIM}ip -6 rule  /" -e "s/\$/${NC}/"
    local f tbl wgi real
    for f in "$PG_DIR"/*.conf; do
        tbl=$(conf_val "$f" TABLE) t=$(conf_val "$f" TUNNEL) wgi=$(conf_val "$f" WG_IF wg0)
        if ! iface_exists "$wgi"; then
            real=$(wg_by_table "$tbl")
            if [[ -n "$real" ]]; then
                dr_bad "node $(basename "$f" .conf): $wgi does not exist, the node uses $real"
                hint "gretun pg edit $(basename "$f" .conf) --wg-if $real"
            elif [[ -n "$(wg_ifaces)" ]]; then
                dr_bad "node $(basename "$f" .conf): $wgi does not exist (WireGuard here: $(wg_ifaces | paste -sd' ' -))"
                hint "gretun pg edit $(basename "$f" .conf) --wg-if NAME"
            fi
        fi
        out=$(ip -4 route show table "$tbl" 2>/dev/null)
        grep -q "^default dev $t" <<<"$out" && dr_ok "table $tbl IPv4: default dev $t" \
            || { dr_bad "table $tbl IPv4 has no 'default dev $t' (clients get 'unreachable')"; hint "Is $t up? gretun heal"; }
        if [[ -n "$(conf_val "$f" V6_SUBNETS)" ]]; then
            out=$(ip -6 route show table "$tbl" 2>/dev/null)
            grep -q "^default dev $t" <<<"$out" && dr_ok "table $tbl IPv6: default dev $t" \
                || dr_bad "table $tbl IPv6 has no 'default dev $t'"
        fi
    done
    for w in $(printf '%s\n%s\n' "$(wan_if 4)" "$(wan_if 6)" | sed '/^$/d' | sort -u); do
        v=$(sysctl_get "net/ipv6/conf/$w/accept_ra")
        if [[ "$(sysctl_get net.ipv6.conf.all.forwarding)" == 1 && "$v" == 1 ]]; then
            dr_bad "$w: accept_ra=1 with forwarding on: RA-learned IPv6 will be lost"
            hint "sysctl -w net.ipv6.conf.$w.accept_ra=2"
            hint "(heal does this when PasarGuard or an exit is set up)"
        else
            dr_info "$w: accept_ra=$v"
        fi
    done
    dr_info "forwarding: ipv4=$(sysctl_get net.ipv4.ip_forward) ipv6=$(sysctl_get net.ipv6.conf.all.forwarding)"
    [[ -n "$(ip -6 route show default 2>/dev/null)" ]] && dr_ok "IPv6 default route present" || dr_info "no IPv6 default route"

    wgs=$(offload_ifaces | sed '/^$/d' | sort -u)
    if [[ -n "$wgs" ]]; then
        section "WireGuard"
        for w in $wgs; do
            if iface_exists "$w"; then
                out=$(offload_state "$w")
                [[ "$out" == *on* ]] && dr_bad "$w: offload $out" || dr_ok "$w: offload $out, mtu $(cat "/sys/class/net/$w/mtu" 2>/dev/null || echo ?)"
            else
                dr_info "$w: not present (the node creates it)"
            fi
        done
        [[ -f "$UDEV_RULE" ]] && dr_ok "udev rule re-applies offload settings when $(printf '%s' "$wgs" | paste -sd, -) is re-created"
    fi

    section "Services"
    if (( ! TEST_MODE )); then
        svc_active gretun-heal.timer && dr_ok "gretun-heal.timer active" || { [[ -z "$(tun_list)" ]] || dr_bad "gretun-heal.timer not active"; }
        for n in $(tun_list); do
            svc_active "gretun@$n.service" && dr_ok "gretun@$n active" || dr_bad "gretun@$n not active (starts at boot)"
        done
    fi
    fwd_load
    if (( $(fwd_count tcp) )); then svc_active haproxy && dr_ok "haproxy running" || dr_bad "haproxy stopped"; fi
    if (( $(fwd_count udp) )); then svc_active "$UDP_UNIT" && dr_ok "$UDP_UNIT running" || dr_bad "$UDP_UNIT stopped"; fi
    C=()
    section "Result"
    if (( DR_ISSUES == 0 )); then ok "No problems found."; return 0; fi
    warn "$DR_ISSUES item(s) need attention (the hints are above):"
    # One short line each: the details are in the sections above.
    w=$(term_cols)
    for out in "${DR_LIST[@]}"; do
        (( ${#out} > w - 5 )) && out="${out:0:$((w - 8))}..."
        printf '   - %s\n' "$out"
    done
    if (( IN_MENU )); then hint "Many of them are fixed by: 7) Tools > 7) Repair now"
    else hint "Many of them are fixed by: gretun heal"; fi
}

cmd_bench() {
    local tun p secs="${O_TIME:-10}" out
    need iperf3:iperf3
    pick_tunnel tun
    tun_load "$tun" || die "Unknown tunnel $tun"
    if (( BENCH_SERVER )); then
        info "iperf3 server on ${C[IN4_LOCAL]} (tunnel $tun). Now run 'gretun bench' on the other server. Ctrl+C to stop."
        exec iperf3 -s -B "${C[IN4_LOCAL]}"
    fi
    p="${C[IN4_PEER]}"
    ping_peer "$p" 2 || die "No reply from $p; is the tunnel up?"
    quiet timeout 5 bash -c "exec 3<>/dev/tcp/$p/5201" || die "No iperf3 server on $p. Run 'gretun bench --server' on the other server first."
    section "iperf3 over $tun to $p (${secs}s per test)"
    local name args
    for name in "1 stream, upload|" "16 streams, upload|-P 16" "1 stream, download|-R" "16 streams, download|-R -P 16"; do
        args="${name#*|}"
        # shellcheck disable=SC2086
        out=$(iperf3 -c "$p" -B "${C[IN4_LOCAL]}" -t "$secs" -f m $args 2>&1) || true
        printf '  %-22s %s\n' "${name%%|*}" "$(awk '/receiver/ {for (i = 1; i < NF; i++) if ($(i + 1) ~ /bits\/sec/) v = $i " " $(i + 1)} END {print (v ? v : "failed")}' <<<"$out")"
        sleep 1
    done
    hint "Upload = from this server to the other. Low numbers with offload on? See: gretun doctor"
}

TUNE_KEYS=(net.core.default_qdisc=fq net.ipv4.tcp_congestion_control=bbr net.core.rmem_max=67108864
    net.core.wmem_max=67108864 "net.ipv4.tcp_rmem=4096 131072 67108864" "net.ipv4.tcp_wmem=4096 65536 67108864"
    net.core.netdev_max_backlog=16384 net.ipv4.tcp_mtu_probing=1 net.ipv4.tcp_slow_start_after_idle=0)
cmd_tune() {
    local kv k v content="$MARK
# Optional tuning by gretun. Revert with: gretun tune revert"
    case "${ARGS[0]:-show}" in
        apply)
            quiet modprobe tcp_bbr || true
            local -a items=("${TUNE_KEYS[@]}")
            if [[ -e /proc/sys/net/netfilter/nf_conntrack_max ]]; then
                v=$(sysctl_get net.netfilter.nf_conntrack_max)
                (( v < 262144 )) && v=262144
                items+=("net.netfilter.nf_conntrack_max=$v")
            fi
            (( DRY )) || mkdir -p "$ETC"
            for kv in "${items[@]}"; do
                k="${kv%%=*}" v="${kv#*=}"
                if [[ "$k" == net.ipv4.tcp_congestion_control ]] \
                    && ! grep -qw bbr <<<"$(sysctl_get net.ipv4.tcp_available_congestion_control)"; then
                    warn "BBR is not available in this kernel; skipped."
                    continue
                fi
                sysctl_get "$k" >/dev/null || continue
                if (( ! DRY )) && ! grep -q "^$k=" "$TUNE_PREV" 2>/dev/null; then
                    printf '%s=%s\n' "$k" "$(sysctl_get "$k")" >>"$TUNE_PREV"
                fi
                run sysctl -q -w "$k=$v" >/dev/null || warn "Could not set $k"
                content+=$'\n'"$k = $v"
            done
            write_file "$SYSCTL_TUNE" 644 "$content" || true
            if grep -q 'tcp_congestion_control = bbr' <<<"$content"; then
                write_file "$R/etc/modules-load.d/gretun-tune.conf" 644 "$MARK"$'\n'"tcp_bbr" || true
            fi
            ok "Tuning applied (BBR + fq, larger buffers, conntrack). Offloads on the physical NIC are not touched." ;;
        revert)
            if [[ -f "$TUNE_PREV" ]]; then
                while IFS='=' read -r k v; do run sysctl -q -w "$k=$v" >/dev/null || true; done <"$TUNE_PREV"
                remove_file "$TUNE_PREV"
            fi
            remove_file "$SYSCTL_TUNE"
            remove_file "$R/etc/modules-load.d/gretun-tune.conf"
            ok "Tuning reverted to the values from before 'gretun tune apply'." ;;
        show)
            for kv in "${TUNE_KEYS[@]}"; do k="${kv%%=*}"; printf '  %-40s %s\n' "$k" "$(sysctl_get "$k" || echo -)"; done
            if [[ -f "$SYSCTL_TUNE" ]]; then info "Tuning is applied ($SYSCTL_TUNE)."; else info "Tuning is not applied."; fi ;;
        *) die "Usage: gretun tune apply|revert|show" ;;
    esac
}

cmd_alert() {
    case "${ARGS[0]:-show}" in
        set)
            local url="${ARGS[1]:-$O_URL}"
            if [[ -z "$url" ]] && (( HAVE_TTY && ! ASSUME_YES )); then
                printf '%sExample: https://ntfy.sh/my-secret-topic or your own server%s\n' "$DIM" "$NC"
                while :; do
                    ask url "ntfy topic URL (Enter = cancel)"
                    [[ -n "$url" ]] || { info "Nothing changed."; return 0; }
                    [[ "$url" =~ ^https?:// ]] && break
                    warn "The URL must start with http:// or https://"
                done
            fi
            [[ -n "$url" ]] || ask url "ntfy topic URL (e.g. https://ntfy.sh/my-secret-topic or your own server)"
            [[ "$url" =~ ^https?:// ]] || die "The URL must start with http:// or https://"
            need curl:curl
            C=([NTFY_URL]="$url" [NTFY_TOKEN]="$O_TOKEN")
            write_file "$ALERT_CONF" 600 "$(conf_text NTFY_URL NTFY_TOKEN)" || true
            ok "Alerts go to $url (tunnel down/up, rollbacks)."
            hint "Iran servers often cannot reach ntfy.sh; a self-hosted ntfy server works better there." ;;
        test) alert "Test alert from gretun on $(hostname)" && ok "Sent." || err "Sending failed (is the URL reachable from this server?)" ;;
        off) remove_file "$ALERT_CONF"; ok "Alerts off." ;;
        show) if [[ -f "$ALERT_CONF" ]]; then info "Alerts: $(conf_val "$ALERT_CONF" NTFY_URL)"; else info "Alerts are off."; fi ;;
        *) die "Usage: gretun alert set URL [--token T] | test | off" ;;
    esac
}

self_install() {
    (( TEST_MODE || DRY )) && return 0
    local src
    src=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)
    [[ -f "$src" && "$src" != "$INSTALL_PATH" ]] || return 0
    if [[ ! -f "$INSTALL_PATH" ]] || ! cmp -s "$src" "$INSTALL_PATH"; then
        local inst
        inst=$(file_version "$INSTALL_PATH")
        if [[ -n "$inst" ]] && ver_lt "$VERSION" "$inst"; then
            info "Not replacing $INSTALL_PATH: it is newer ($inst) than this copy ($VERSION)."
            return 0
        fi
        install -m 755 "$src" "$INSTALL_PATH"
        info "Installed as $INSTALL_PATH (run 'gretun' from now on)."
    fi
}
file_version() { sed -n 's/^readonly VERSION="\([0-9][0-9.]*\)"$/\1/p' "$1" 2>/dev/null | head -n1; }
ver_lt() { [[ "$1" != "$2" && "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]]; }
UPDATE_URL="${GRETUN_UPDATE_URL:-https://raw.githubusercontent.com/kiarash-re/gretun/main/gretun}"
# gretun update [--file PATH]: download (or take a local file), check it, replace.
cmd_update() {
    local tmp newv inst_v="$VERSION"
    tmp=$(mktemp)
    if [[ -n "$O_FILE" ]]; then
        [[ -f "$O_FILE" ]] || { rm -f "$tmp"; die "File not found: $O_FILE"; }
        cp "$O_FILE" "$tmp"
    else
        need curl:curl
        info "Downloading the latest version from GitHub..."
        if ! curl -fsSL --connect-timeout 10 --max-time 60 -o "$tmp" "$UPDATE_URL"; then
            rm -f "$tmp"
            err "Could not download from GitHub (common on Iran servers)."
            hint "On a computer or server that can reach GitHub:"
            hint "  curl -fsSL -o gretun $UPDATE_URL"
            hint "  scp gretun root@THIS_SERVER:/root/gretun"
            hint "Then here:  gretun update --file /root/gretun"
            return 1
        fi
    fi
    newv=$(file_version "$tmp")
    # A complete file starts with the bash shebang, ends with the call to main
    # and parses; this catches truncated downloads and HTML error pages.
    if [[ -z "$newv" ]] || ! head -n1 "$tmp" | grep -q '^#!.*bash' \
        || [[ "$(tail -n1 "$tmp")" != 'main "$@"' ]] || ! bash -n "$tmp" 2>/dev/null; then
        rm -f "$tmp"
        die "The new file is not a valid gretun script (incomplete download?). Nothing was changed."
    fi
    if [[ -f "$INSTALL_PATH" ]]; then inst_v=$(file_version "$INSTALL_PATH"); fi
    if [[ -f "$INSTALL_PATH" ]] && cmp -s "$tmp" "$INSTALL_PATH"; then
        rm -f "$tmp"
        ok "Already up to date (gretun $newv)."
        return 0
    fi
    printf '  installed: %s\n  new:       %s\n' "${inst_v:-none}" "$newv"
    if [[ -n "$inst_v" ]] && ver_lt "$newv" "$inst_v"; then
        warn "The new file is an OLDER version."
        if (( ASSUME_YES && ! FORCE )); then rm -f "$tmp"; die "Not downgrading without --force."; fi
        confirm "Downgrade to $newv?" N || { rm -f "$tmp"; return 0; }
    else
        confirm "Update to $newv?" Y || { rm -f "$tmp"; return 0; }
    fi
    if (( DRY || TEST_MODE )); then
        printf '%s[dry-run]%s install %s -> %s\n' "$DIM" "$NC" "$newv" "$INSTALL_PATH"
        rm -f "$tmp"
        return 0
    fi
    install -m 755 "$tmp" "$INSTALL_PATH.new"
    mv -f "$INSTALL_PATH.new" "$INSTALL_PATH"
    rm -f "$tmp"
    jlog "updated $inst_v -> $newv"
    ok "gretun updated to $newv. Your tunnels and settings in $ETC are unchanged."
    # The new version re-applies its units and rules (same as the heal timer does).
    info "Re-applying the configuration with the new version..."
    exec 9>&-
    "$INSTALL_PATH" sync </dev/null || warn "Re-applying reported problems; run: gretun doctor"
    if [[ -n "${GRETUN_IN_MENU:-}" ]]; then warn "Exit and start gretun again to use the new menu."; fi
}
cmd_uninstall() {
    warn "This removes every tunnel, forwarder rule, PasarGuard/exit setting and unit created by gretun."
    confirm "Uninstall gretun?" N || return 0
    NO_RB=1 ASSUME_YES=1
    local f n
    for f in "$PG_DIR"/*.conf; do ARGS=("$(basename "$f" .conf)"); cmd_pg_remove || true; done
    for f in "$EXIT_DIR"/*.conf; do remove_file "$f"; done
    fwd_load
    if (( ${#F_LISTEN[@]} )) || [[ -f "$UDP_CFG" ]]; then cmd_fwd_uninstall || true; fi
    for n in $(tun_list); do
        ufw_gre delete "$(conf_val "$TUN_DIR/$n.conf" REMOTE)"
        if (( ! TEST_MODE )); then run systemctl disable "gretun@$n.service" >/dev/null 2>&1 || true; fi
        remove_file "$TUN_DIR/$n.conf"
    done
    remove_file "$GLOBAL_CONF"
    sync_all || true
    [[ -f "$SYSCTL_TUNE" ]] && ARGS=(revert) && cmd_tune
    if (( ! TEST_MODE )); then
        run systemctl stop gretun-rollback.timer >/dev/null 2>&1 || true
        remove_file "$SYSTEMD_DIR/gretun@.service"
        daemon_reload
    fi
    remove_file "$SYSCTL_FWD"
    run rm -rf "$RB_PENDING" "$RUNDIR"
    if (( PURGE )); then
        run rm -rf "$ETC" "$STATE"
        (( TEST_MODE )) || remove_file "$INSTALL_PATH"
        ok "gretun removed completely."
    else
        ok "gretun removed. Backups and legacy files stay in $ETC (use --purge to delete them and the program)."
    fi
    info "Runtime sysctl values (forwarding) stay until the next reboot."
}

# hidden: re-run by systemd, udev, the rollback timer
cmd_tunnel_up() {
    HEAL_MODE=1
    take_lock
    tunnel_ensure "$1" || exit 1
    fw_sync || true
    routes_sync
}
cmd_tunnel_down() { tunnel_delete_iface "$1"; }
cmd_heal() {
    HEAL_MODE=1
    take_lock nonblock
    # The rollback timer does not survive a reboot: an expired change is undone here.
    if (( ! DRY )) && rb_pending && [[ -f "$RB_PENDING/deadline" ]] \
        && (( $(cat "$RB_PENDING/deadline" 2>/dev/null || echo 0) <= $(date +%s) )); then
        warn "A change was not confirmed before its deadline (reboot?); rolling it back."
        rb_fire
        return 0
    fi
    if (( ! DRY )) && rb_pending && [[ ! -f "$RB_PENDING/deadline" ]] \
        && [[ -n "$(find "$RB_PENDING" -maxdepth 0 -mmin +30 2>/dev/null)" ]]; then
        warn "A change was left half-way without a safety timer; rolling it back."
        rb_fire
        return 0
    fi
    (( DRY )) || mkdir -p "$RUNDIR"
    (( DRY )) || traffic_update 1 >/dev/null 2>&1 || true
    sync_all quiet || true
    (( DRY )) || watchdog
    fwd_heal || true
}

