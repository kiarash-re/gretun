rb_left() {  # time left on the safety timer, e.g. "2m 05s"
    local d=""
    d=$(cat "$RB_PENDING/deadline" 2>/dev/null) || d=""
    [[ "$d" =~ ^[0-9]+$ ]] || { printf 'unknown time'; return 0; }
    d=$((d - $(date +%s)))
    (( d > 0 )) || d=0
    printf '%dm %02ds' "$((d / 60))" "$((d % 60))"
}
pending_notice() {
