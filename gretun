exit_verify() {  # exit_verify TUNNEL
    local f="$EXIT_DIR/$1.conf" fails=0 t s w out p4
    conf_load "$f" || { err "No exit for $1."; return 1; }
    t=$(cget TUNNEL)
    local v4 v6
    v4=$(cget V4_SUBNETS) v6=$(cget V6_SUBNETS)
    C=()
    section "Check: exit via $t"
    p4=$(conf_val "$TUN_DIR/$t.conf" IN4_PEER)
    if ping_peer "$p4" 3; then ok "Tunnel ping $p4: ${PING_RTT} ms"; else err "Tunnel ping $p4 failed"; fails=$((fails + 1)); fi
    [[ "$(sysctl_get net.ipv4.ip_forward)" == 1 ]] && ok "IPv4 forwarding on" || { err "IPv4 forwarding off"; fails=$((fails + 1)); }
    [[ "$(sysctl_get net.ipv6.conf.all.forwarding)" == 1 ]] && ok "IPv6 forwarding on" || { err "IPv6 forwarding off"; fails=$((fails + 1)); }
    w=$(wan_if 6)
    if [[ -n "$w" ]]; then
        out=$(sysctl_get "net/ipv6/conf/$w/accept_ra")
        if [[ "$out" == 1 ]]; then err "accept_ra on $w is 1: IPv6 from RA will be lost"; fails=$((fails + 1))
        else ok "accept_ra on $w: $out"; fi
        if [[ -n "$(ip -6 route show default 2>/dev/null)" ]]; then ok "IPv6 default route present"
        else err "no IPv6 default route"; fails=$((fails + 1)); fi
    fi
    for s in $v4; do
        out=$(ip -4 route show "$s" 2>/dev/null)
        [[ "$out" == *"dev $t"* ]] && ok "route $s -> $t" || { err "route $s via $t missing"; fails=$((fails + 1)); }
    done
    for s in $v6; do
        out=$(ip -6 route show "$s" 2>/dev/null)
        [[ "$out" == *"dev $t"* ]] && ok "route $s -> $t" || { err "route $s via $t missing"; fails=$((fails + 1)); }
    done
    if nft list table ip "${NFT_T}_nat" >/dev/null 2>&1; then ok "NAT: table ip ${NFT_T}_nat present"
    else err "NAT table missing"; fails=$((fails + 1)); fi
    if [[ -n "$v6" ]]; then
        nft list table ip6 "${NFT_T}_nat" >/dev/null 2>&1 && ok "NAT: table ip6 ${NFT_T}_nat present" \
            || { err "IPv6 NAT table missing"; fails=$((fails + 1)); }
    fi
    if (( fails == 0 )); then ok "All checks passed."; else warn "$fails check(s) need attention."; fi
    (( fails == 0 ))
}
