# banner: a short dashboard at the top of the main menu. One label column,
# one line per tunnel, then an attention area with the menu path of each fix.
banner() {
    local n w=4 cols v4 v6 st dot rtt tmp f rows lab=Tunnels sep=", " rest
    local -a names=() attns=()
    local -A today=()
    clear 2>/dev/null || true
    menu_state
    cols=$(term_cols)
    if (( UTF )); then sep=" · "; fi
    if (( cols >= 64 )); then
        printf '%sgretun %s%s   %sGRE tunnels, port forwarding, PasarGuard exit%s\n' "$BOLD" "$VERSION" "$NC" "$DIM" "$NC"
    else
        printf '%sgretun %s%s\n' "$BOLD" "$VERSION" "$NC"
    fi
    hrule
    printf '%-9s%s%s%s\n' Server "$(hostname 2>/dev/null || echo '?')" "$sep" "$(server_role)"
    v4=$(detect_local 4) v6=$(detect_local 6)
    if [[ -n "$v4" && -n "$v6" ]] && (( 9 + ${#v4} + 3 + ${#v6} <= cols )); then
        printf '%-9s%s   %s\n' IP "$v4" "$v6"
    else
        if [[ -n "$v4" ]]; then printf '%-9s%s\n' IPv4 "$v4"; fi
        if [[ -n "$v6" ]]; then printf '%-9s%s\n' IPv6 "$v6"; fi
    fi
    mapfile -t names < <(tun_list)
    if (( ST_TUN )); then
        rows=$(traffic_update 0 2>/dev/null || true)
        while IFS='|' read -r n _ _ _ _ _ v4 v6 _; do
            [[ -n "$n" ]] && today[$n]=$(( v4 + v6 ))
        done <<<"$rows"
    fi
    if (( ${#names[@]} == 0 )); then
        printf '%-9s%s\n' Tunnels "none yet"
    else
        # One ping per tunnel, all at once, so the menu opens quickly.
        tmp=$(mktemp -d)
        for n in "${names[@]}"; do
            (( ${#n} <= w )) || w=${#n}
            if iface_exists "$n"; then
                ( if ping_peer "$(conf_val "$TUN_DIR/$n.conf" IN4_PEER)" 1; then printf '%s' "$PING_RTT" >"$tmp/$n"
                  else : >"$tmp/$n"; fi ) &
            fi
        done
        wait
        for n in "${names[@]}"; do
            if [[ ! -e "$tmp/$n" ]]; then
                st=down dot=bad
                attns+=("$n is down|6) Doctor")
            elif [[ -s "$tmp/$n" ]]; then
                rtt=$(<"$tmp/$n") rtt="${rtt%.*}"
                if [[ "$rtt" == 0 ]]; then st="<1 ms"; else st="$rtt ms"; fi
                dot=ok
            else
                st="no reply" dot=warn
                attns+=("$n: no reply from the other side|6) Doctor")
            fi
            # The far end: its role when this server has both kinds, else its address.
            if (( ST_IRAN && ST_FOREIGN )); then
                case "$(conf_val "$TUN_DIR/$n.conf" ROLE)" in iran) rest="to foreign" ;; foreign) rest="to Iran" ;; *) rest="" ;; esac
            else
                rest=$(conf_val "$TUN_DIR/$n.conf" REMOTE)
            fi
            printf '%-9s%s %-*s  %s' "$lab" "$(sdot "$dot")" "$w" "$n" "$(paint "$dot" "$(cpad "$st" 8)")"
            if [[ -n "${today[$n]:-}" ]]; then printf '  today %8s' "$(fmt_bytes "${today[$n]}")"; fi
            if [[ -n "$rest" ]] && (( 9 + 2 + w + 2 + 8 + 16 + 2 + ${#rest} <= cols )); then
                printf '  %s%s%s' "$DIM" "$rest" "$NC"
            fi
            printf '\n'
            lab=""
        done
        rm -rf "$tmp"
        if [[ -n "$rows" ]]; then
            printf '%-9stoday %s%s%s   month %s%s%s\n' Traffic "$BOLD" "$(fmt_bytes "$(traffic_sum "$rows" 7 8 tunnels)")" "$NC" \
                "$BOLD" "$(fmt_bytes "$(traffic_sum "$rows" 10 11 tunnels)")" "$NC"
        fi
    fi
    if (( ST_FWD )); then
        local tcp udp svcs="" kinds=""
        tcp=$(fwd_count tcp) udp=$(fwd_count udp)
        (( tcp )) && kinds="TCP $tcp"
        (( udp )) && kinds+="${kinds:+, }UDP $udp"
        if (( tcp )); then
            if svc_active haproxy; then svcs+="  $(sdot ok) TCP"
            else svcs+="  $(sdot bad) $(paint bad "TCP stopped")"; attns+=("TCP forwarder (haproxy) stopped|7) Tools > 7) Repair"); fi
        fi
        if (( udp )); then
            if svc_active "$UDP_UNIT"; then svcs+="  $(sdot ok) UDP"
            else svcs+="  $(sdot bad) $(paint bad "UDP stopped")"; attns+=("UDP forwarder stopped|7) Tools > 7) Repair"); fi
        fi
        printf '%-9s%s port%s (%s)%s\n' Forward "$ST_FWD" "$( (( ST_FWD == 1 )) || printf s)" "$kinds" "$svcs"
    fi
    for f in "$PG_DIR"/*.conf; do
        printf '%-9s%s via %s, WireGuard %s\n' "PG node" "$(conf_val "$f" NODE)" "$(conf_val "$f" TUNNEL)" "$(conf_val "$f" WG_IF wg0)"
    done
    for f in "$EXIT_DIR"/*.conf; do
        printf '%-9svia %s for %s\n' Exit "$(conf_val "$f" TUNNEL)" "$(conf_val "$f" V4_SUBNETS)"
    done
    if [[ -f "$ALERT_CONF" ]]; then printf '%-9s%s\n' Alerts "on (ntfy)"; fi
    hrule
    if (( ST_TUN == 0 )); then
        printf '%sStart:%s on the foreign server choose 1) GRE tunnel > 1),\n' "$BOLD" "$NC"
        printf '       then paste its key on the Iran server: 1) > 2).\n'
    fi
    # The pending change first: it has a deadline.
    pending_notice
    for f in "${attns[@]}"; do attn "${f%%|*}" "${f#*|}"; done
    if (( ST_TUN && ${#attns[@]} == 0 )) && ! rb_pending; then
        printf '%s %sEverything is up.%s\n' "$(sdot ok)" "$GREEN" "$NC"
    fi
}
