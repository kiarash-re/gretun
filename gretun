            "$(mi "$tuned" "Tuning: revert" "back to the old values" "tuning is not applied")" \
            "#Pending change" \
            "$(mi "$pend" "Keep the pending change" "$label" "nothing is waiting")" \
            "$(mi "$pend" "Undo the pending change" "right now" "nothing is waiting")" \
            "#Maintenance" \
            "Repair now (heal)|re-apply tunnels and rules" \
            "Update from GitHub|download the latest gretun" \
            "Update from a file|a copy sent here with scp" \
            "Uninstall gretun|removes everything it set up"
        ARGS=()
        case "$c" in
            0) return 0 ;;
            1) run_action cmd_bench ;;
            2) BENCH_SERVER=1; ( cmd_bench ) || true; BENCH_SERVER=0 ;;
            3) ARGS=(apply); run_action cmd_tune ;; 4) ARGS=(revert); run_action cmd_tune ;;
            5) run_action rb_confirm ;; 6) run_action rb_fire ;;
            7) ( cmd_heal ) || true; ok "Done. Check the result with: 6) Doctor"; pause ;;
            8) O_FILE=""; GRETUN_IN_MENU=1 run_action cmd_update ;;
            9) if ask_update_file O_FILE; then GRETUN_IN_MENU=1 run_action cmd_update; fi; O_FILE="" ;;
            10) run_action cmd_uninstall ;;
        esac
    done
}
menu_main() {
    (( HAVE_TTY )) || die "No terminal for the menu. Use the CLI: gretun help"
    local c fwd
    IN_MENU=1
    while :; do
        banner
        fwd=0
        if (( ST_IRAN || ST_FWD )) || [[ -f "$RULES" || -f "$UDP_CFG" ]]; then fwd=1; fi
        choose c "Main menu" \
            "GRE tunnel|create, connect, list, edit" \
            "$(mi "$fwd" "Port forwarding" "Iran port -> foreign server" "needs an Iran-side tunnel")" \
            "$(mi "$(( ST_TUN + ST_PG + ST_EXIT ))" "PasarGuard node" "WireGuard clients exit abroad" "needs a tunnel first")" \
            "$(mi "$ST_TUN" "Traffic" "usage and live speed" "needs a tunnel first")" \
            "Status|everything at a glance" \
            "Doctor|find problems, with hints" \
            "Tools|speed test, tuning, update"
        case "$c" in
            0) exit 0 ;; 1) menu_tunnel ;; 2) menu_fwd ;; 3) menu_pg ;; 4) menu_traffic ;;
            5) run_action cmd_status ;; 6) run_action cmd_doctor ;; 7) menu_tools ;;
        esac
    done
}

# ======================================================================
# CLI
# ======================================================================
usage() {
    cat <<EOF
gretun $VERSION - GRE tunnels, port forwarding through them, PasarGuard WireGuard exit

Usage: gretun                         interactive menu
       gretun COMMAND [options]

1) GRE tunnel
  tunnel add --role foreign --peer IRAN_IP [--family 4|6] [--local IP] [--mtu N] [--name gre1]
                                     foreign server: create, print the connection key
  tunnel add --key KEY               Iran server: connect with the key (pings the peer)
  tunnel add --role iran --peer FOREIGN_IP --inner-net 10.X.Y.0/30 [--family] [--mtu]
  tunnel list | status [NAME]        state, ping/RTT/loss (v4+v6), traffic
  tunnel key NAME [--raw]            print the connection key again (foreign side)
  tunnel remove NAME [--force]
  tunnel edit [NAME] [--mtu N] [--local IP] [--peer IP] [--inner-net 10.X.Y.0/30] [--role iran|foreign]
                                     change a tunnel (no options: interactive editor)
  tunnel forward [NAME] --ports 6000[,7000=443] [--proto tcp|udp|both]
                                     Iran server: forward ports through the tunnel to the foreign server
  tunnel import manual [--if gre1] [--role iran|foreign] [--inner-peer IP]
  tunnel import legacy               take over HAProxy.sh / HAProxy-GRE6.sh

2) Port forwarding (Iran port -> foreign server)
  fwd add --ports 443,8443|4040=443 [--dest TUNNEL_INNER_IP] [--proto tcp|udp|both] [--proxy] [--check]
  fwd list | remove PORT... | status | monitor [--interval 2] | rebuild | uninstall [--purge]

3) PasarGuard WireGuard node via GRE
  pg setup [--node NAME|--node-dir /opt/NAME] [--tunnel gre1] --v4 10.0.0.0/16 [--v6 fd10:10::/64]
           [--table N] [--wg-if wgX]          Iran server; prints an exit key
                                     (the WireGuard interface is detected; --wg-if overrides)
  pg edit [NODE] [--wg-if wg1] [--v4 CIDR] [--v6 CIDR|none] [--table N] [--tunnel gre1]
  pg status | verify | panel | key | remove [NODE]
  exit add --key EXIT_KEY  |  exit add --tunnel gre1 --v4 CIDR [--v6 CIDR] [--wan eth0]
  exit edit [TUNNEL] [--v4 CIDR] [--v6 CIDR|none] [--wan eth0|auto]
  exit list | remove TUNNEL                   foreign server

Traffic
  traffic                            usage per tunnel: today, this month, total, last 7 days
  traffic live [--interval 1]        live speed with bars (Ctrl+C stops)

Tools
  status | doctor | heal
  bench [--tunnel gre1] [--time 10]   |  bench --server
  tune apply | revert | show
  alert set URL [--token T] | test | off
  confirm | rollback                 keep / undo the pending routing change
  update [--file /root/gretun]       download the latest version (or use a copied file)
  install | uninstall [--purge] | version

Global options
  -y, --yes            answer yes / use defaults (non-interactive)
  --dry-run            print what would change, change nothing
  --confirm            keep a routing change right away if its checks pass
  --rollback-secs N    safety timer for routing changes (default 180-600)
  --replace-haproxy-cfg  allow replacing an unrelated haproxy.cfg (a backup is kept)
  --no-color

Logs: journalctl -t gretun
EOF
}
parse_args() {
    while (( $# )); do
        case "$1" in
            -y|--yes) ASSUME_YES=1 ;;
            --dry-run) DRY=1 ;;
            --confirm) AUTO_CONFIRM=1 ;;
            --no-color) NO_COLOR=1; set_colors ;;
            --force) FORCE=1 ;;
            --purge) PURGE=1 ;;
            --raw) RAW=1 ;;
            --proxy) O_PROXY=1 ;;
            --check) O_CHECK=1 ;;
            --server) BENCH_SERVER=1 ;;
            --replace-haproxy-cfg) REPLACE_HAPROXY=1 ;;
            --fire) ;;
            --rollback-secs|--role|--family|--peer|--local|--mtu|--name|--key|--if|--dest|--ports|--proto|\
            --interval|--node|--node-dir|--tunnel|--v4|--v6|--table|--wg-if|--wan|--url|--token|--time|\
            --inner-peer|--inner-net|--file)
                (( $# >= 2 )) || die "$1 needs a value."
                case "$1" in
                    --rollback-secs) [[ "$2" =~ ^[0-9]+$ ]] && (( $2 >= 30 || (TEST_MODE && $2 >= 3) )) || die "--rollback-secs must be >= 30"; RB_SECS="$2" ;;
                    --role) O_ROLE="$2" ;; --family) O_FAMILY="$2" ;; --peer) O_PEER="$2" ;; --local) O_LOCAL="$2" ;;
                    --mtu) O_MTU="$2" ;; --name) O_NAME="$2" ;; --key) O_KEY="$2" ;; --if) O_IF="$2" ;;
                    --dest) O_DEST="$2" ;; --ports) O_PORTS="$2" ;; --proto) O_PROTO="$2" ;; --interval) O_INTERVAL="$2" ;;
                    --node) O_NODE="$2" ;; --node-dir) O_NODE_DIR="$2" ;; --tunnel) O_TUNNEL="$2" ;;
                    --v4) O_V4="$2" ;; --v6) O_V6="$2" ;; --table) O_TABLE="$2" ;; --wg-if) O_WG_IF="$2" ;;
                    --wan) O_WAN="$2" ;; --url) O_URL="$2" ;; --token) O_TOKEN="$2" ;; --time) O_TIME="$2" ;;
                    --inner-peer) O_INNER_PEER="$2" ;; --inner-net) O_INNER_NET="$2" ;; --file) O_FILE="$2" ;;
                esac
                shift ;;
            -h|--help) ARGS+=(help) ;;
            -*) die "Unknown option: $1 (see: gretun help)" ;;
            *) ARGS+=("$1") ;;
        esac
        shift
    done
}
preflight() {
    [[ "$(id -u)" == 0 ]] || die "Run as root (sudo -i)."
    if (( ! TEST_MODE )); then
        have systemctl || die "systemd is required."
        local id=""
        id="$(os_field ID) $(os_field ID_LIKE)"
        [[ "$id" == *debian* || "$id" == *ubuntu* ]] || warn "Only Debian/Ubuntu are supported; continuing anyway."
    fi
}
main() {
    parse_args "$@"
    set -- "${ARGS[@]}"
    local cmd="${1:-menu}" sub="${2:-}"
    case "$cmd" in
        help) usage; return 0 ;;
        version|--version) printf 'gretun %s\n' "$VERSION"; return 0 ;;
    esac
    preflight
    # hidden helpers called by systemd/udev/timers
    case "$cmd" in
        tunnel-up) cmd_tunnel_up "${sub:?}"; return ;;
        tunnel-down) cmd_tunnel_down "${sub:?}"; return ;;
        offload-apply) offload_apply "${sub:?}"; return ;;
        heal) cmd_heal; return ;;
        pg-restart) shift; pg_restart "$@" || true; sync_all quiet || true; return ;;
        # The timer's rollback waits long: a menu left open must not cancel it.
        rollback) take_lock 1800; rb_fire; return ;;
        confirm) take_lock; rb_confirm; return ;;
    esac
    if [[ "$cmd" == menu ]]; then menu_main; return; fi
    shift
    if (( $# )); then shift; fi
    ARGS=("$@")
    take_lock
    case "$cmd" in
        tunnel|tunnels|t)
            case "$sub" in
                add) self_install; cmd_tunnel_add ;; list|status|"") tunnel_status "${ARGS[0]:-}" ;;
                key) cmd_tunnel_key ;; remove|rm|del) cmd_tunnel_remove ;; edit|set) cmd_tunnel_edit ;;
                forward|fwd) self_install; cmd_tunnel_forward ;;
                import) self_install; cmd_import ;;
                *) die "Unknown: gretun tunnel $sub (see: gretun help)" ;;
            esac ;;
        fwd|forward|forwarder|f)
            case "$sub" in
                add) self_install; cmd_fwd_add ;; list|"") cmd_fwd_list ;; remove|rm|del) cmd_fwd_remove ;;
                status) cmd_fwd_status ;; monitor) exec 9>&-; cmd_fwd_monitor ;; rebuild) cmd_fwd_rebuild ;;
                uninstall) cmd_fwd_uninstall ;;
                *) die "Unknown: gretun fwd $sub" ;;
            esac ;;
        pg|pasarguard)
            case "$sub" in
                setup|add) self_install; cmd_pg_setup ;; status|verify|"") cmd_pg_status ;; panel) cmd_pg_panel ;;
                key) cmd_pg_key ;; remove|rm|del) cmd_pg_remove ;; edit|set) self_install; cmd_pg_edit ;;
                *) die "Unknown: gretun pg $sub" ;;
            esac ;;
        exit)
            case "$sub" in
                add) self_install; cmd_exit_add ;; list|"") cmd_exit_list ;; status|verify) cmd_pg_status ;;
                remove|rm|del) cmd_exit_remove ;; edit|set) cmd_exit_edit ;;
                *) die "Unknown: gretun exit $sub" ;;
            esac ;;
        traffic|usage)
            case "$sub" in
                ""|show) cmd_traffic ;; live) cmd_traffic_live ;;
                *) die "Unknown: gretun traffic $sub" ;;
            esac ;;
        status) ARGS=("$sub" "${ARGS[@]}"); cmd_status ;;
        doctor) cmd_doctor ;;
        bench) [[ -n "$sub" ]] && O_TUNNEL="${O_TUNNEL:-$sub}"; exec 9>&-; cmd_bench ;;
        tune) ARGS=("$sub" "${ARGS[@]}"); cmd_tune ;;
        alert|alerts) ARGS=("$sub" "${ARGS[@]}"); cmd_alert ;;
        sync) sync_all ;;
        install) self_install; ok "gretun $VERSION is installed in $INSTALL_PATH." ;;
        update|upgrade) cmd_update ;;
        uninstall) cmd_uninstall ;;
        *) die "Unknown command: $cmd (see: gretun help)" ;;
    esac
}

main "$@"
