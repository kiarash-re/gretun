                1) if [[ -n "$(wg_ifaces)" ]]; then printf 'WireGuard interfaces here: %s\n' "$(wg_ifaces | paste -sd' ' -)"; fi
                   ask a "WireGuard interface (interface_name of the panel's WireGuard core)" "$(wg_by_table "$tbl" | grep . || printf '%s' "$wg")"
