                "WireGuard interface: $wg$miss" \
                "Client IPv4 subnets: $v4" \
                "Client IPv6 subnets: ${v6:-none}" \
                "Routing table: $tbl" \
                "Tunnel: $tun" \
                "Apply"
            case "$c" in
