# exit_subnets_free TUNNEL V4 V6: the client subnets must not overlap a route
# or an address of this server (other than gretun's own return routes).
exit_subnets_free() {
    local x fam p bad=0
    for x in $2 $3; do
        fam=4
        if [[ "$x" == *:* ]]; then fam=6; fi
        while read -r p; do
            [[ -n "$p" ]] || continue
            if cidr_overlap "$x" "$p"; then
                err "$x overlaps $p, which this server already uses (its own route or address)."
                bad=1
            fi
        done < <( { ip "-$fam" -o addr show 2>/dev/null | awk '{print $4}'
                    ip "-$fam" route show table main 2>/dev/null | awk -v t="$1" '$0 !~ / proto 147( |$)/ && $0 !~ (" dev " t "( |$)") {
                        d = $1; if (d ~ /^(unicast|local|broadcast|blackhole|unreachable|prohibit|throw)$/) d = $2
                        if (d != "default" && d !~ /^(fe80|ff)/) print d }'; } | sort -u)
    done
    if (( bad )); then
        hint "Use other client subnets in the panel (the WireGuard core's Address) on the Iran server."
        return 1
    fi
}
